# Server Configuration
SERVER_HOST=127.0.0.1
SERVER_PORT=8080

# Database (SQLite)
DATABASE_URL=sqlite:storage/reader.db?mode=rwc

# Storage paths
STORAGE_DIR=storage
ASSETS_DIR=storage/assets

# Web frontend path (adjust if needed)
WEB_ROOT=frontend/dist

# Logging
LOG_LEVEL=info

# Request timeout in seconds
REQUEST_TIMEOUT_SECS=15

# ── 鉴权 ──
# JWT 签名密钥。留空时启动阶段生成随机密钥并写入 <STORAGE_DIR>/jwt_secret，
# 重启后已签发的令牌继续有效。多实例部署必须显式配置同一个值，
# 否则各实例签发的令牌互不认可。
# JWT_SECRET=
# 令牌有效期（秒），默认 7 天。改密码会立即作废该账号的所有旧令牌。
JWT_TTL_SECS=604800

# ── 账号（单用户） ──
# 唯一账号的用户名，首次启动建号时使用；只允许小写字母、数字与下划线。
# 建号后修改它相当于换一个全新账号（旧命名空间下的数据不可见）。
ADMIN_USERNAME=admin
# 唯一账号的密码。非空时**每次启动都会强制写入**（覆盖现有密码），
# 因此它也是「忘记密码」的找回通道；与现有密码相同时是 no-op，不会重置登录态。
# 留空则首次启动随机生成 20 位强密码并打印到启动日志。
# ADMIN_PASSWORD=
# 全局书架上限，0 表示不限制。
USER_BOOK_LIMIT=2000
# 全局本地上传上限，0 表示不限制。
USER_LOCAL_BOOK_LIMIT=50
# 豁免登录失败限速（开发与测试环境用），生产部署不应开启。
# 默认限速规则：IP 登录失败 5 次封该 IP 登录 6h；用户名登录失败 10 次封该用户名登录 6h。
RATE_LIMIT_DISABLED=false

# ── 缓存容量上限 ──
# 缓存不按时间过期，只在显式调用 /reader3/purgeCache 或超出容量时被回收，
# 因此容量上限是唯一的自动回收手段。0 表示不限制。
# 章节正文缓存上限（字节），默认 512MiB
CACHE_USER_LIMIT_BYTES=536870912
# 封面缓存目录上限（字节），默认 256MiB
CACHE_COVER_LIMIT_BYTES=268435456

# ── 评论缓存（章评 / 段评） ──
# 评论是会变的第三方数据（新评论、点赞数、热度排序都在动），因此这里保留
# 时间过期，与正文缓存的「只靠容量回收」不同。默认 7 天，0 表示不过期。
REVIEW_CACHE_TTL_SECS=604800
# 评论缓存上限（字节），默认 64MiB。0 表示不限制。
REVIEW_CACHE_USER_LIMIT_BYTES=67108864

# Outbound request policy (SSRF 防护)
# 是否允许服务端出站请求访问私网/环回/链路本地地址（10.x、192.168.x、127.0.0.1、
# 169.254.169.254 等）。默认 false（安全优先）：公网暴露的部署开箱即不会被打成
# 内网探测代理。书源/模型服务在局域网时（如 http://192.168.x.x:9999），显式设为
# true 整体放行，或保持 false 并用下面的白名单精确放行。
# ALLOW_PRIVATE_NETWORK=false

# 私网白名单（逗号分隔），仅在 ALLOW_PRIVATE_NETWORK=false 时生效。
# 条目支持 IP（192.168.100.99）、网段（192.168.100.0/24）、域名（nas.lan），
# 均可带端口（192.168.100.99:9999，带端口时目标端口也须一致）。
# 注意：名单为空时一律拦截（不等同 ALLOW_PRIVATE_NETWORK=true）；
# 名单非空时只有命中的目标可以出站，其余私网/环回地址一律拦截。
# 注意：值含逗号/空格等特殊字符时必须用双引号包裹，否则 dotenvy 会在该行中断加载、其后的变量全部失效
# PRIVATE_NETWORK_WHITELIST="192.168.100.99:9999, 192.168.100.0/24"

# ── 后端 AI 模型（可选） ──
# 后端模型配置只存在于服务端（env/.env），从不下发到浏览器——前端只能看到
# 「是否已配置可用」的布尔状态，请求经 /reader3/aiProxy 转发，浏览器全程
# 接触不到 Key。三组各自独立，按需启用。
#
# 文本模型（AI资料生成）：
# AI_TEXT_ENABLED=true
# AI_TEXT_BASE_URL=https://api.openai.com
# AI_TEXT_API_KEY=sk-...
# AI_TEXT_MODEL=deepseek-flash
# AI_TEXT_USE_FULL_URL=false
# 图片模型（AI 地图）：
# AI_IMAGE_ENABLED=false
# AI_IMAGE_BASE_URL=https://api.openai.com
# AI_IMAGE_API_KEY=sk-...
# AI_IMAGE_MODEL=gpt-image-1
# AI_IMAGE_SIZE=1024x1024
# AI_IMAGE_USE_FULL_URL=false
# 语音模型（听书 TTS）：
# AI_SPEECH_ENABLED=false
# AI_SPEECH_BASE_URL=https://api.openai.com
# AI_SPEECH_API_KEY=sk-...
# AI_SPEECH_MODEL=gpt-4o-mini-tts
# AI_SPEECH_VOICE=alloy
# AI_SPEECH_FORMAT=mp3
# AI_SPEECH_USE_FULL_URL=false

# ── AI 资料编排（Python sidecar）──
# AI 资料的生成循环由后端拉起的 Python 进程完成，宿主机需要 Python >=3.11
# 与仓库 sidecar/ 目录（Docker 镜像已内置，裸机部署见 docs/guide/configuration.md）。
# Windows 上 `python` 可能命中 Microsoft Store 占位符，建议配 Python 绝对路径。
# AGENT_SIDECAR_ENABLED=true
# 依赖管理推荐 uv（自动建 sidecar/.venv、按 pyproject 钉版安装，不污染系统 Python）：
# 留空 AGENT_SIDECAR_UV 时探测 PATH 里的 uv；PATH 没有才降级到 AGENT_SIDECAR_COMMAND
#（需宿主机预装 httpx/pydantic）。
# AGENT_SIDECAR_UV=
# AGENT_SIDECAR_COMMAND=python -m agent_sidecar
# AGENT_SIDECAR_CHAPTER_TIMEOUT_SECS=600

# CORS 跨域来源白名单（逗号分隔），如：
#   CORS_ALLOWED_ORIGINS=https://a.example,https://b.example
# 留空（默认）表示仅同源——不发送任何 CORS 响应头，浏览器同源策略自然生效。
# 前端与后端同域部署（WEB_ROOT 静态托管）时无需配置；仅在前后端分离
# 且前端运行在独立域名时才需要显式放行对应来源。
# CORS_ALLOWED_ORIGINS=

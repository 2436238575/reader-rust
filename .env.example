# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Database (SQLite)
DATABASE_URL=sqlite:storage/reader.db?mode=rwc

# Storage paths
STORAGE_DIR=storage
ASSETS_DIR=storage/assets

# Web frontend path (adjust if needed)
WEB_ROOT=frontend/dist

# Logging
LOG_LEVEL=info

# Request timeout in seconds
REQUEST_TIMEOUT_SECS=15

# ── 鉴权 ──
# JWT 签名密钥。留空时启动阶段生成随机密钥并写入 <STORAGE_DIR>/jwt_secret，
# 重启后已签发的令牌继续有效。多实例部署必须显式配置同一个值，
# 否则各实例签发的令牌互不认可。
# JWT_SECRET=
# 令牌有效期（秒），默认 7 天。改密码会立即作废该账号的所有旧令牌。
JWT_TTL_SECS=604800

# ── 账号（单用户） ──
# 唯一账号的用户名，首次启动建号时使用；只允许小写字母、数字与下划线。
# 建号后修改它相当于换一个全新账号（旧命名空间下的数据不可见）。
ADMIN_USERNAME=admin
# 唯一账号的密码。非空时**每次启动都会强制写入**（覆盖现有密码），
# 因此它也是「忘记密码」的找回通道；与现有密码相同时是 no-op，不会重置登录态。
# 留空则首次启动随机生成 20 位强密码并打印到启动日志。
# ADMIN_PASSWORD=
# 全局书架上限，0 表示不限制。
USER_BOOK_LIMIT=2000
# 全局本地上传上限，0 表示不限制。
USER_LOCAL_BOOK_LIMIT=0
# 豁免登录失败限速（开发与测试环境用），生产部署不应开启。
# 默认限速规则：IP 登录失败 5 次封该 IP 登录 6h；用户名登录失败 10 次封该用户名登录 6h。
RATE_LIMIT_DISABLED=false

# ── 缓存容量上限 ──
# 缓存不按时间过期，只在显式调用 /reader3/purgeCache 或超出容量时被回收，
# 因此容量上限是唯一的自动回收手段。0 表示不限制。
# 章节正文缓存上限（字节），默认 512MiB
CACHE_USER_LIMIT_BYTES=536870912
# 封面缓存目录上限（字节），默认 256MiB
CACHE_COVER_LIMIT_BYTES=268435456

# ── 评论缓存（章评 / 段评） ──
# 评论是会变的第三方数据（新评论、点赞数、热度排序都在动），因此这里保留
# 时间过期，与正文缓存的「只靠容量回收」不同。默认 7 天，0 表示不过期。
REVIEW_CACHE_TTL_SECS=604800
# 评论缓存上限（字节），默认 64MiB。0 表示不限制。
REVIEW_CACHE_USER_LIMIT_BYTES=67108864

# Outbound request policy (SSRF 防护)
# 是否允许服务端出站请求访问私网/环回/链路本地地址（10.x、192.168.x、127.0.0.1、
# 169.254.169.254 等）。默认 true：自托管单用户场景下，局域网书源、本地书源服务
# （如 http://192.168.x.x:9999）、本地模型服务都属正常用法。
#
# 公网暴露的部署请设为 false，否则拿到登录态的人能把服务端当成内网探测代理。
# 设为 false 后，指向内网的书源会直接报错并给出被拦的地址。
# ALLOW_PRIVATE_NETWORK=true

# CORS 跨域来源白名单（逗号分隔），如：
#   CORS_ALLOWED_ORIGINS=https://a.example,https://b.example
# 留空（默认）表示仅同源——不发送任何 CORS 响应头，浏览器同源策略自然生效。
# 前端与后端同域部署（WEB_ROOT 静态托管）时无需配置；仅在前后端分离
# 且前端运行在独立域名时才需要显式放行对应来源。
# CORS_ALLOWED_ORIGINS=

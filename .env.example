# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Database (SQLite)
DATABASE_URL=sqlite:storage/reader.db?mode=rwc

# Storage paths
STORAGE_DIR=storage
ASSETS_DIR=storage/assets

# Web frontend path (adjust if needed)
WEB_ROOT=frontend/dist

# Logging
LOG_LEVEL=info

# Request timeout in seconds
REQUEST_TIMEOUT_SECS=15

# Security settings
SECURE=true
SECURE_KEY=

# User registration
INVITE_CODE=
USER_LIMIT=50
USER_BOOK_LIMIT=2000
# 0 means unlimited
USER_LOCAL_BOOK_LIMIT=0

# Outbound request policy (SSRF 防护)
# 是否允许服务端出站请求访问私网/环回/链路本地地址（10.x、192.168.x、127.0.0.1、
# 169.254.169.254 等）。注释掉（默认）则跟随 SECURE：
#   SECURE=true  -> false（多用户/公网部署，拦截内网目标）
#   SECURE=false -> true （本机单用户部署，放行局域网书源与本地模型服务）
# 只有在确定服务不暴露给第三方时才显式设为 true。
# ALLOW_PRIVATE_NETWORK=true

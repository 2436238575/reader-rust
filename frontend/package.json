{
  "name": "frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "gen:api": "openapi-typescript ../openapi.yaml -o src/api/generated.ts",
    "check:api": "npm run -s gen:api && git diff --exit-code -- src/api/generated.ts"
  },
  "dependencies": {
    "axios": "^1.8.2",
    "dompurify": "^3.4.16",
    "opencc-js": "^1.0.5",
    "pinia": "^4.1.0",
    "virtua": "^0.54.0",
    "vue": "^3.5.30",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/tsconfig": "^0.9.0",
    "jsdom": "^30.1.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "vite": "^8.0.1",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.2.5"
  }
}

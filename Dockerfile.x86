# Dockerfile for x86_64 - using pre-built binary
# Build binary first: cargo build --release --target x86_64-unknown-linux-musl
# Build frontend first: cd frontend && npm install && npm run build

FROM alpine:3.19

RUN apk add --no-cache ca-certificates tzdata python3 py3-pip \
    && addgroup -S app && adduser -S -G app app

WORKDIR /app

# Copy pre-built binary
COPY target/x86_64-unknown-linux-musl/release/reader-rust /app/reader-rust

# Copy frontend dist
COPY frontend/dist /app/web/dist

# Copy agent sidecar (AI 资料/地图编排) + pinned deps
COPY sidecar /app/sidecar
# 依赖版本以 sidecar/pyproject.toml 为唯一钉版源
RUN pip install --no-cache-dir ./sidecar

# Create storage directory and hand ownership to the non-root user
# (SQLite database, file cache and uploaded assets all live under /app/storage)
RUN mkdir -p /app/storage/assets && chown -R app:app /app

# Drop privileges: the server must not run as root
USER app

# Environment defaults
ENV SERVER_HOST=0.0.0.0
ENV SERVER_PORT=8080
ENV DATABASE_URL=sqlite:/app/storage/reader.db?mode=rwc
ENV STORAGE_DIR=/app/storage
ENV ASSETS_DIR=/app/storage/assets
ENV WEB_ROOT=/app/web/dist
ENV LOG_LEVEL=info
# Alpine 无 `python` 命令，显式覆盖默认的 `python -m agent_sidecar`
ENV AGENT_SIDECAR_COMMAND="python3 -m agent_sidecar"

EXPOSE 8080

VOLUME ["/app/storage"]

CMD ["./reader-rust"]
